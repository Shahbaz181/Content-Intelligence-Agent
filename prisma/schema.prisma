generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id                  String               @id
  name                String
  industry            String
  tone                String[]             @default([])
  thingsToAvoid       String[]             @default([])
  audience            String[]             @default([])
  platforms           String[]             @default([])
  goals               String[]             @default([])
  competitors          String[]             @default([])
  synthetic            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  contentItems         ContentItem[]
  campaigns            Campaign[]
  audienceComments     AudienceComment[]
  analyticsSnapshots   AnalyticsSnapshot[]
  weeklyPlan           WeeklyPlan?

  @@map("brands")
}

model Campaign {
  id          String        @id
  brandId     String
  name        String
  description String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  result      String
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@index([brandId, startDate])
  @@map("campaigns")
}

model ContentItem {
  id             String    @id
  brandId        String
  campaignId     String?
  title          String
  platform       String
  format         String
  topic          String
  contentType    String?
  publishedDate  DateTime  @db.Date
  text           String    @default("")
  metrics        Json      @default("{}")
  metricsMeasuredAt DateTime?
  performance    String    @default("Not measured")
  synthetic      Boolean   @default(false)
  brand          Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([brandId, publishedDate])
  @@index([campaignId])
  @@map("content_items")
}

model AudienceComment {
  id      String   @id
  brandId String
  text    String
  themes  String[] @default([])
  date    DateTime @db.Date
  source  String
  brand   Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, date])
  @@map("audience_comments")
}

model AnalyticsSnapshot {
  id         String   @id
  brandId    String
  period     String
  topThemes  String[] @default([])
  weakThemes String[] @default([])
  gaps       String[] @default([])
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, period])
  @@map("analytics_snapshots")
}

model WeeklyPlan {
  brandId   String   @id
  items     Json
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("weekly_plans")
}
